NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1
APP_ORIGIN=http://localhost:4200
# VPS acessada deste computador; na rede interna do EasyPanel use o host do serviço e a porta 3306.
DB_HOST=187.41.120.114
DB_PORT=3308
DB_USER=master
DB_PASSWORD=change-this-database-password
DB_NAME=curso_ingles_db
DB_CONNECTION_LIMIT=10
# Use TLS for remote connections; point to the provider CA if required.
DB_SSL=false
DB_SSL_CA_FILE=
INITIAL_USERNAME=aluno
INITIAL_PASSWORD=change-this-login-password
SESSION_DAYS=14
TRUST_PROXY=false
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MAX_TOKENS=3500
# auto: tenta JSON Schema e usa modo JSON validado localmente quando o provedor não oferece Schema.
AI_RESPONSE_FORMAT=auto
AI_TIMEOUT_MS=20000
SESSION_EXERCISES=20
SESSION_REVIEW_RATIO=0.25
MASTERY_MIN_ATTEMPTS=8
EXAM_PASS_PERCENT=85
EXAM_QUESTIONS=12
MASTERY_THRESHOLD=0.85
REVIEW_INTERVALS=1,3,7,14,30
# Integration tests must use an explicitly separate MariaDB database.
TEST_DB_NAME=curso_ingles_test
# Only used by the optional Docker Compose database; choose a separate password.
LOCAL_DB_ROOT_PASSWORD=change-this-local-root-password
